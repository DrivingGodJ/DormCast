<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DormCast.Core</AssemblyName>
    <RootNamespace>DormCast</RootNamespace>
    <Version>0.5.0</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="SIPSorcery" Version="10.0.17" />
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <EmbeddedResource Include="wwwroot\*" />
  </ItemGroup>
</Project>
